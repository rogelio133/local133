@model ReceiptPageViewModel
@{
    var receipt = Model.Receipt;
    ViewData["Title"] = receipt.BusinessName is null ? "Recibo de pago" : $"Recibo de {receipt.BusinessName}";
    ViewData["NoIndex"] = true;
    ViewData["BodyClass"] = "receipt-page";
}
@section Head {
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
}
@* Recibo público (2026-11-27: en la portada, sin encabezado ni pie). Ticket de papel (ajustes 2026-11-26): el
   contenedor lleva la sombra y el artículo la máscara de los dientes. Nunca el folio: es para el cliente, sin sesión. *@
<main class="receipt-main">
    <div class="receipt-ticket-wrap">
        <article class="receipt-ticket" data-receipt>
            <div class="receipt-ticket-section text-center">
                @if (receipt.LogoUrl is not null)
                {
                    <img class="receipt-logo d-block mx-auto mb-3" src="@receipt.LogoUrl" alt="@(receipt.BusinessName is null ? "Logo del negocio" : $"Logo de {receipt.BusinessName}")" data-receipt-logo />
                }
                <p class="text-body-secondary small mb-1">Recibo de pago</p>
                <h1 class="h4 mb-3 text-break" data-receipt-business>@(receipt.BusinessName ?? "Recibo de pago")</h1>

                <i class="bi bi-check-circle-fill text-success receipt-check d-block mb-2" aria-hidden="true"></i>
                <p class="fw-semibold text-success mb-1">Pago recibido</p>
                <p class="display-5 fw-semibold mb-1" data-receipt-amount>@receipt.AmountText</p>
                @if (receipt.ConceptText is not null)
                {
                    <p class="text-body-secondary text-break mb-0" data-receipt-concept>@receipt.ConceptText</p>
                }
            </div>

            @if (receipt.IsCart)
            {
                <div class="receipt-ticket-section">
                    <ul class="list-unstyled mb-0" data-receipt-items>
                        @foreach (var item in receipt.Items)
                        {
                            <li class="d-flex justify-content-between gap-3 mb-2" data-receipt-item>
                                <span class="receipt-item-info">
                                    <span class="d-block text-break">@item.Name</span>
                                    <span class="d-block small text-body-secondary">@item.Quantity × @item.UnitPriceText</span>
                                </span>
                                <span class="fw-semibold text-nowrap">@item.AmountText</span>
                            </li>
                        }
                    </ul>
                    <p class="receipt-ticket-total d-flex justify-content-between gap-3 fw-bold mb-0">
                        <span>Total</span>
                        <span class="text-nowrap" data-receipt-total>@receipt.AmountText</span>
                    </p>
                </div>
            }

            <div class="receipt-ticket-section">
                <dl class="row small mb-0">
                    @if (receipt.PaidAtText is not null)
                    {
                        <dt class="col-5 fw-normal text-body-secondary">Fecha</dt>
                        <dd class="col-7 mb-1" data-receipt-paid-at>@receipt.PaidAtText</dd>
                    }
                    <dt class="col-5 fw-normal text-body-secondary">Forma de pago</dt>
                    <dd class="col-7 mb-1">CoDi (transferencia)</dd>
                    @foreach (var payment in receipt.Payments)
                    {
                        @if (receipt.Payments.Count > 1)
                        {
                            <dt class="col-5 fw-normal text-body-secondary">Pago</dt>
                            <dd class="col-7 mb-1">@payment.AmountText · @payment.PaidAtText</dd>
                        }
                        @if (payment.TrackingKey is not null)
                        {
                            <dt class="col-5 fw-normal text-body-secondary">Clave de rastreo</dt>
                            <dd class="col-7 mb-1 text-break font-monospace" data-receipt-tracking>@payment.TrackingKey</dd>
                        }
                    }
                </dl>
            </div>
            @if (Model.PoweredByUrl is not null)
            {
                @* Básico y vencido (5.10): la liga lleva a la portada con el código de invitación del vendedor. *@
                <div class="receipt-ticket-section text-center small" data-receipt-powered-by>
                    <a class="link-body-emphasis text-decoration-none" href="@Model.PoweredByUrl" target="_blank" rel="noopener">
                        Cobrado con <strong>Local133</strong>
                    </a>
                    <span class="d-block text-body-secondary">Cobra con CoDi desde tu celular, sin terminal.</span>
                </div>
            }
        </article>
    </div>

    <div class="receipt-notes">
        <p class="small text-body-secondary text-center mt-3 mb-2" data-receipt-not-official>
            Este recibo no es un comprobante fiscal ni oficial: solo confirma que el negocio recibió tu pago.
        </p>
        <p class="small text-body-secondary text-center mb-3">
            Con la clave de rastreo puedes consultar la transferencia en el portal de Banxico.
        </p>
    </div>
    <div class="text-center d-print-none">
        <button type="button" class="btn btn-outline-primary" data-receipt-print>
            <i class="bi bi-printer me-1" aria-hidden="true"></i> Imprimir o guardar PDF
        </button>
    </div>
</main>

@section Scripts {
    <script src="~/js/receipt-print.js" asp-append-version="true"></script>
}
