<!DOCTYPE html>
<html lang="es-MX">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#E4007C" />
    <meta name="description" content="@(ViewData["Description"] as string ?? "Cobra con CoDi® desde tu celular, sin terminal ni efectivo. El dinero llega completo a tu cuenta, sin comisión por venta.")" />
    @if (ViewData["NoIndex"] is true)
    {
        <meta name="robots" content="noindex, nofollow" />
    }
    <title>@(ViewData["Title"] is string title ? $"{title} · Local133" : "Local133")</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="icon" href="~/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    @* Solo la portada usa Baloo 2 + Nunito Sans; el portal sigue con Bungee y Atkinson Hyperlegible. *@
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
    @* Compilado desde Styles/landing.scss (marca de Local133.Web/Styles/_custom.scss). *@
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
@* Sin encabezado ni pie: cada página los agrega (la portada y las legales; el recibo no lleva ninguno y el catálogo
   solo _StoreBar). ViewData["BodyClass"] agrega una clase al body y ViewData["NoIndex"] = true pide no indexar. *@
<body class="@(ViewData["BodyClass"] as string)">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
