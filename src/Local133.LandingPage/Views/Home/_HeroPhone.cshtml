@* Maqueta decorativa de la pantalla «Cobrar» (no es interactiva). Para cambiarla por el video, reemplazar el
   contenido de .phone-screen (o todo el parcial) por <video autoplay muted loop playsinline>. *@
<div class="phone" role="img" aria-label="Pantalla de cobro de Local133: $150.00 con su código QR, lista para escanear">
    <div class="phone-frame">
        <div class="phone-screen">
            <div class="phone-header">
                <div class="phone-merchant">
                    <span class="logo-tile logo-tile-xs"><img src="~/img/local133-logo-48.png" srcset="/img/local133-logo-96.png 2x, /img/local133-logo-144.png 3x" alt="" width="48" height="48" /></span>
                    <span class="phone-merchant-text">
                        <span class="phone-merchant-name">Tacos Don Beto</span>
                        <span class="phone-merchant-place">Puesto 14 · Tianguis</span>
                    </span>
                </div>
                <span class="phone-tag">Pro</span>
            </div>
            <div class="phone-body">
                <span class="phone-label">Monto a cobrar</span>
                <span class="phone-amount">$150.00</span>
                <div class="phone-qr">
                    <svg width="150" height="150" viewBox="0 0 21 21" shape-rendering="crispEdges" aria-hidden="true">
                        <g fill="#1F1720">
                            <rect x="0" y="0" width="7" height="7" /><rect x="1" y="1" width="5" height="5" fill="#FFFFFF" /><rect x="2" y="2" width="3" height="3" />
                            <rect x="14" y="0" width="7" height="7" /><rect x="15" y="1" width="5" height="5" fill="#FFFFFF" /><rect x="16" y="2" width="3" height="3" />
                            <rect x="0" y="14" width="7" height="7" /><rect x="1" y="15" width="5" height="5" fill="#FFFFFF" /><rect x="2" y="16" width="3" height="3" />
                            <rect x="8" y="0" width="1" height="2" /><rect x="10" y="1" width="2" height="1" /><rect x="9" y="3" width="1" height="2" /><rect x="11" y="4" width="2" height="2" />
                            <rect x="8" y="8" width="2" height="1" /><rect x="0" y="8" width="2" height="1" /><rect x="3" y="9" width="2" height="2" /><rect x="5" y="8" width="1" height="3" />
                            <rect x="11" y="8" width="1" height="3" /><rect x="13" y="9" width="2" height="1" /><rect x="16" y="8" width="3" height="1" /><rect x="19" y="10" width="2" height="2" />
                            <rect x="8" y="11" width="2" height="2" /><rect x="14" y="11" width="1" height="3" /><rect x="16" y="12" width="2" height="2" /><rect x="1" y="11" width="1" height="2" />
                            <rect x="8" y="15" width="1" height="3" /><rect x="10" y="14" width="2" height="1" /><rect x="11" y="17" width="3" height="1" /><rect x="9" y="19" width="2" height="2" />
                            <rect x="15" y="15" width="2" height="2" /><rect x="18" y="14" width="2" height="1" /><rect x="19" y="17" width="2" height="2" /><rect x="14" y="19" width="3" height="1" />
                        </g>
                        <rect x="8.5" y="8.5" width="4" height="4" rx="1" fill="#E4007C" />
                    </svg>
                </div>
                <span class="phone-hint">Expira en 9:42 · Escanea con la app de tu banco</span>
                <div class="phone-actions">
                    <span class="phone-action">Enviar a celular</span>
                    <span class="phone-action phone-action-dark">Nuevo cobro</span>
                </div>
            </div>
        </div>
    </div>
</div>
