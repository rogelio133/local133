@model LandingViewModel
@{
    ViewData["Title"] = "Cobra con CoDi";
    // El servidor pinta la primera palabra: el título queda completo sin JS y para los buscadores;
    // rotating-word.js (copia del de Local133.Web) rota las demás.
    var words = Model.Words;
    var rotatingWords = words.Count > 1 ? System.Text.Json.JsonSerializer.Serialize(words) : null;
}
<main class="landing d-flex align-items-center">
    <div class="container text-center">
        <img class="landing-logo mb-4" src="~/local133.svg" alt="Local133" width="973" height="740" asp-append-version="true" />
        @* Razor no omite un data-* nulo (lo deja vacío): sin lista, la palabra va sin el atributo. *@
        @if (rotatingWords is not null)
        {
            <h1 class="display-6 fw-semibold">Cobra con CoDi desde&nbsp;tu <span class="rotating-word" data-rotating-words="@rotatingWords">@words[0]</span></h1>
        }
        else
        {
            <h1 class="display-6 fw-semibold">Cobra con CoDi desde&nbsp;tu <span class="rotating-word">@words[0]</span></h1>
        }
        <p class="lead text-body-secondary landing-lead mx-auto">Genera un QR, tu cliente paga desde su app bancaria y el dinero llega directo a tu cuenta.</p>
        <div class="d-grid d-sm-flex justify-content-sm-center mt-4">
            <a class="btn btn-primary btn-lg" href="@Model.AppUrl" target="_blank" rel="noopener">Empieza a cobrar</a>
        </div>
    </div>
</main>

@section Scripts {
    @if (rotatingWords is not null)
    {
        <script src="~/js/rotating-word.js" asp-append-version="true"></script>
    }
}
