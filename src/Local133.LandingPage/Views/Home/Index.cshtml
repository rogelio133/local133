@model LandingViewModel
@{
    ViewData["Title"] = "Cobra con CoDi®";
    ViewData["Description"] = "Escribe el monto y muestra el QR, o manda el cobro al celular de tu cliente. El dinero llega completo a tu cuenta, sin comisión por venta, y tu pantalla avisa «Pago recibido» al instante.";
}
<partial name="_Header" model="Model.Chrome" />

<main>
    <partial name="_Hero" />
    <partial name="_MadeFor" />
    <partial name="_HowItWorks" />
    <partial name="_Tools" />
    <partial name="_YourMoney" />
    <partial name="_Pricing" />
    <partial name="_Referral" />
    <partial name="_Faq" />
    <partial name="_Closing" />
</main>

<partial name="_Footer" model="Model.Chrome" />

@section Scripts {
    <script src="~/js/landing.js" asp-append-version="true" defer></script>
    @* rotating-word.js es copia del de Local133.Web (SharedAssetsTests): anima todos los [data-rotating-words]. *@
    @if (Model.RotatingWordsJson is not null)
    {
        <script src="~/js/rotating-word.js" asp-append-version="true" defer></script>
    }
}
