@{
    (string Question, string Answer)[] questions =
    [
        ("¿Qué es CoDi®?", "CoDi® (Cobro Digital) es la plataforma del Banco de México para cobrar y pagar con transferencias desde el celular, con un código QR o una notificación a la app del banco."),
        ("¿Cobran comisión por cada venta?", "No. Local133 no cobra comisión por venta y nunca toca tu dinero: los pagos van directo a tu CLABE. Solo pagas tu plan, Básico o Pro, al terminar tu prueba."),
        ("¿Cómo paga mi cliente?", "Tu cliente escanea tu QR con la app de su banco, o recibe la solicitud de pago en su celular cuando tú escribes su número. Solo confirma, y tu pantalla cambia a «Pago recibido»."),
        ("¿Cuánto tarda en activarse mi cuenta?", "Banxico revisa tu CLABE para CoDi® y puede tardar hasta 5 días hábiles. Mientras, puedes cargar tus productos. Te avisamos por correo en cuanto tu cuenta queda activa. Tu prueba de 15 días empieza con tu primer cobro, así que la espera no te quita días."),
        ("¿Qué pasa al terminar mis 15 días de prueba?", "Te avisamos 3 días antes. Eliges Básico o Pro; si no pagas, no podrás generar cobros nuevos, pero tu información se queda: tu catálogo, tu historial y tus datos. No guardamos tu tarjeta ni te cobramos en automático."),
        ("¿Qué diferencia hay entre Básico y Pro?", "Los dos cobran sin límite (con uso justo) y tienen historial completo, corte de caja y recibo por WhatsApp. Pro suma tus productos: catálogo editable, cobro con carrito, catálogo en línea, recibo con tu logo y exportar a Excel."),
        ("¿Cómo pago mi plan?", "Desde «Mi plan» eliges Básico o Pro, por 1 mes o por un año, y pagas con un link de pago con CoDi® o tarjeta. Tu plan se activa en cuanto se confirma el pago. Si subes de Básico a Pro, los días de Básico que te quedan se vuelven días de Pro."),
        ("¿Y si dejo de pagar?", "Tienes 5 días de gracia después de un periodo pagado. Luego tu plan vence: ya no generas cobros nuevos, pero puedes entrar, ver tus ventas y compartir sus recibos. Tu catálogo, tu historial y tus datos se quedan guardados para cuando vuelvas a pagar."),
    ];
}
@* <details> nativos: se abren sin JS. La transición de apertura es CSS (::details-content); sin soporte, abren al instante. *@
<section id="preguntas" class="faq-section">
    <div class="landing-container faq">
        <div class="section-head section-head-center" data-reveal>
            <p class="eyebrow">Preguntas frecuentes</p>
            <h2 class="section-title">¿Tienes dudas?</h2>
        </div>
        <div class="faq-list" data-reveal>
            @foreach (var (question, answer) in questions)
            {
                <details class="faq-item">
                    <summary class="faq-question">@question<span class="faq-plus" aria-hidden="true">+</span></summary>
                    <p class="faq-answer">@answer</p>
                </details>
            }
        </div>
    </div>
</section>
