@page
@model LogoutModel
@{
    ViewData["Title"] = "Salir";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <h1 class="h3">@ViewData["Title"]</h1>
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="mt-3" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post" data-disable-on-submit>
                <button id="logout" type="submit" class="btn btn-primary">Cerrar sesión</button>
            </form>
        }
        else
        {
            <p>Cerraste sesión.</p>
            <a class="btn btn-outline-primary" asp-page="./Login">Volver a entrar</a>
        }
    </div>
</div>
