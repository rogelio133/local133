@page
@model RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <h1 class="h3 mb-1">@ViewData["Title"]</h1>
        <p class="text-secondary">Regístrate para cobrar con CoDi desde tu puesto.</p>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                <label asp-for="Input.Password"></label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                <div class="form-text">Mínimo 8 caracteres y al menos un número.</div>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="contraseña" />
                <label asp-for="Input.ConfirmPassword"></label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <partial name="_AcceptLegalCheckbox" for="Input" />
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Crear cuenta</button>
        </form>

        <p class="mt-3 text-center">¿Ya tienes cuenta? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Entrar</a></p>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="text-center text-secondary small my-3">o regístrate con</div>
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-grid gap-2">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <partial name="_ExternalProviderButton" model='new ExternalProviderButton(provider, "Regístrate")' />
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
