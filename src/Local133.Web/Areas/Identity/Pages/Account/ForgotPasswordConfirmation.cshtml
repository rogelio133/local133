@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Revisa tu correo";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <i class="bi bi-envelope display-4 text-primary" aria-hidden="true"></i>
        <h1 class="h3 mt-2">@ViewData["Title"]</h1>
        <p>Si el correo corresponde a una cuenta confirmada, te enviamos una liga para restablecer tu contraseña.</p>
        <a class="btn btn-outline-primary" asp-page="./Login">Volver a entrar</a>
    </div>
</div>
