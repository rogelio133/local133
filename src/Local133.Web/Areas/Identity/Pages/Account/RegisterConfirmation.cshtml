@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Revisa tu correo";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <i class="bi bi-envelope-check display-4 text-primary" aria-hidden="true"></i>
        <h1 class="h3 mt-2">@ViewData["Title"]</h1>
        <p>Te enviamos una liga a <strong>@Model.Email</strong> para confirmar tu cuenta. Ábrela para poder entrar.</p>
        <p class="small text-body-secondary">¿No te llegó? Revisa la carpeta de spam o <a asp-page="./ResendEmailConfirmation">reenvía el correo</a>.</p>
    </div>
</div>
