@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Contraseña actualizada";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <i class="bi bi-check-circle display-4 text-success" aria-hidden="true"></i>
        <h1 class="h3 mt-2">@ViewData["Title"]</h1>
        <p>Tu contraseña se cambió. Ya puedes entrar con la nueva.</p>
        <a class="btn btn-primary" asp-page="./Login">Entrar</a>
    </div>
</div>
