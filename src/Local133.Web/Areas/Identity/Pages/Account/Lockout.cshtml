@page
@model LockoutModel
@{
    ViewData["Title"] = "Cuenta bloqueada";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <i class="bi bi-lock display-4 text-danger" aria-hidden="true"></i>
        <h1 class="h3 mt-2 text-danger">@ViewData["Title"]</h1>
        <p>Hubo demasiados intentos fallidos. Espera 15 minutos e intenta de nuevo, o <a asp-page="./ForgotPassword">restablece tu contraseña</a>.</p>
    </div>
</div>
