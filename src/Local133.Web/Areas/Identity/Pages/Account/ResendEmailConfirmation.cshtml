@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Reenviar confirmación";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-secondary">Escribe tu correo y te mandamos otra liga para confirmar tu cuenta.</p>
        @if (Model.Sent)
        {
            <div class="alert alert-success" role="status">Si hay una cuenta pendiente de confirmar con ese correo, te enviamos la liga.</div>
        }
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="nombre@ejemplo.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reenviar</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
