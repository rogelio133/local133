@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5">
        <h1 class="h3">@ViewData["Title"]</h1>
        <p class="text-body-secondary">
            Entraste con <strong>@Model.ProviderDisplayName</strong>. Revisa tu correo para terminar de crear tu cuenta.
        </p>
        <p class="small text-body-secondary">
            Si conservas el correo de @Model.ProviderDisplayName, entras de inmediato. Si escribes otro, te mandaremos un correo para confirmarlo.
        </p>
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <partial name="_OwnerNameField" for="Input" />
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="nombre@ejemplo.com" />
                <label asp-for="Input.Email"></label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <partial name="_ReferralCodeField" for="Input" />
            <partial name="_AcceptLegalCheckbox" for="Input" />
            <button type="submit" class="w-100 btn btn-lg btn-primary">Crear cuenta</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
