@page
@model EmailModel
@{
    ViewData["Title"] = "Correo";
    ViewData["ActivePage"] = ManageNavPages.Email;
}
<h2 class="h5">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="email-form" method="post" data-disable-on-submit>
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    @if (Model.IsEmailConfirmed)
    {
        <div class="form-floating mb-3 input-group">
            <input asp-for="Email" class="form-control" placeholder="correo" disabled />
            <div class="input-group-append">
                <span class="h-100 input-group-text text-success fw-bold" title="Confirmado"><i class="bi bi-check-lg" aria-hidden="true"></i></span>
            </div>
            <label asp-for="Email" class="form-label"></label>
        </div>
    }
    else
    {
        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="correo" disabled />
            <label asp-for="Email" class="form-label"></label>
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link px-0">Enviar correo de confirmación</button>
        </div>
    }
    <div class="form-floating mb-3">
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="nuevo@ejemplo.com" />
        <label asp-for="Input.NewEmail" class="form-label"></label>
        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
    </div>
    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-100 btn btn-lg btn-primary">Cambiar correo</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
