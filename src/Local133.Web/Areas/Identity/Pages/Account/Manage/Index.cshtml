@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<h2 class="h5">@ViewData["Title"]</h2>
<partial name="_StatusMessage" for="StatusMessage" />
<div class="form-floating mb-3">
    <input asp-for="Username" class="form-control" placeholder="correo" disabled />
    <label asp-for="Username"></label>
</div>
@if (Model.IsMerchant)
{
    @* 4.1: el celular y los datos del negocio se editan en «Mi información». *@
    <p class="text-body-secondary" data-manage-profile-link>
        Tu teléfono y los datos de tu negocio están en <a href="~/app/mi-informacion">Mi información</a>.
    </p>
}
