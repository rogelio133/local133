@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acceso denegado";
}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-7 col-lg-5 text-center">
        <i class="bi bi-shield-lock display-4 text-danger" aria-hidden="true"></i>
        <h1 class="h3 mt-2 text-danger">@ViewData["Title"]</h1>
        <p>Tu cuenta no tiene permiso para ver esta página.</p>
        <a class="btn btn-outline-primary" href="~/">Ir al inicio</a>
    </div>
</div>
