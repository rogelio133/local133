@using Local133.Web.Areas.Merchant.Controllers
@using Local133.Web.Areas.Merchant.Models
@using Local133.Domain.Subscriptions
@model MyPlanViewModel
@{
    ViewData["Title"] = "Mi plan";
    var notice = TempData[PlanController.NoticeKey] as string;
}
@* «Mi plan» (5.15): la página de la cuenta, no del pago. Los botones llevan a la sección de su plan en el checkout; el link de Pey solo nace al
   pulsar «Pagar» en el resumen del pedido. *@
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8" data-my-plan>
        <a class="d-inline-block mb-3" href="~/app/mas"><i class="bi bi-chevron-left" aria-hidden="true"></i> Más</a>
        <h1 class="h4 mb-3">Mi plan</h1>

        @if (notice is not null)
        {
            <div class="alert alert-warning" role="alert" data-plan-notice>@notice</div>
        }

        @if (Model.Plan is { } plan)
        {
            <div class="card card-body mb-3 d-flex flex-row align-items-center gap-3 @plan.BorderClass" data-plan-tier="@plan.Tier">
                <i class="bi @plan.Icon fs-3 @plan.IconClass" aria-hidden="true"></i>
                <span class="flex-grow-1">
                    <span class="d-block fw-bold" data-plan-title>@plan.Title</span>
                    <span class="d-block small text-body-secondary" data-plan-detail>@plan.Detail</span>
                </span>
            </div>
        }
        else
        {
            <div class="card card-body mb-3" data-plan-onboarding>
                <span class="fw-bold">Tu prueba de Pro aún no empieza</span>
                <span class="small text-body-secondary">Tu prueba de @Model.TrialDays días de Pro empieza con tu primer cobro. Después podrás elegir tu plan.</span>
            </div>
        }

        @if (Model.RenewalNotice is { } renewal)
        {
            @* Sin botón propio: «Renovar mi plan …» va justo abajo, al mismo lugar (2026-11-27). *@
            <div class="alert @(renewal.IsUrgent ? "alert-warning" : "alert-info") d-flex align-items-center gap-2" role="status" data-renewal-notice>
                <i class="bi @(renewal.IsUrgent ? "bi-hourglass-split" : "bi-calendar-event") fs-4 d-none d-sm-inline" aria-hidden="true"></i>
                <span class="flex-grow-1">
                    <span class="d-block fw-bold">@renewal.Title</span>
                    <span class="d-block small">@renewal.Message</span>
                </span>
            </div>
        }

        @if (Model.Actions.Count > 0)
        {
            <div class="d-grid gap-2 d-sm-flex flex-sm-wrap mb-3" data-plan-actions>
                @foreach (var action in Model.Actions)
                {
                    <a class="btn @(action.IsPrimary ? "btn-primary" : "btn-outline-primary") d-flex flex-column justify-content-center"
                       href="@Url.Content("~" + action.Url)" data-plan-action="@action.Key">
                        <span>@action.Text</span>
                        @if (action.Detail is not null)
                        {
                            <span class="small fw-normal opacity-75">@action.Detail</span>
                        }
                    </a>
                }
            </div>
        }
        else if (Model.IsDisabled)
        {
            <div class="alert alert-secondary" role="status" data-plan-disabled>Tu cuenta está dada de baja: no puedes pagar un plan.</div>
        }

        @if (Model.Orders.Count > 0)
        {
            <div class="card mb-3" data-plan-orders>
                <div class="card-header fw-semibold">Tus pedidos</div>
                <ul class="list-group list-group-flush">
                    @foreach (var order in Model.Orders)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2"
                            data-plan-order="@order.Id" data-plan-order-status="@order.Status">
                            <span>
                                <span class="d-block">
                                    <span class="fw-semibold">Pedido @order.Number</span> · @order.Title
                                </span>
                                <span class="d-block small text-body-secondary">
                                    @order.AmountText · @order.StatusText · @order.DateText@(order.MethodText is null ? "" : $" · {order.MethodText}")
                                </span>
                            </span>
                            <a class="btn @(order.IsPaid ? "btn-outline-secondary" : "btn-outline-primary") btn-sm text-nowrap"
                               href="@Url.Content("~" + order.Url)" data-plan-order-link>@order.LinkText</a>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="card mb-3">
            <div class="card-header fw-semibold">Qué incluye cada plan</div>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0" data-plan-features>
                    <thead>
                        <tr>
                            <th scope="col" class="fw-normal text-body-secondary small ps-3">Función</th>
                            <th scope="col" class="small">Básico</th>
                            <th scope="col" class="small pe-3">Pro</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var row in Model.Features)
                        {
                            <tr>
                                <td class="ps-3">
                                    @row.Feature
                                    @if (row.ComingSoon)
                                    {
                                        <partial name="_ComingSoonBadge" />
                                    }
                                </td>
                                <td>@row.Basic</td>
                                <td class="fw-semibold pe-3">@row.Pro</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <a class="d-inline-flex align-items-center gap-2 small mb-3" href="~/app/invita" data-plan-invite>
            <i class="bi bi-gift" aria-hidden="true"></i> Gana días de tu plan invitando a otros vendedores
        </a>
    </div>
</div>
