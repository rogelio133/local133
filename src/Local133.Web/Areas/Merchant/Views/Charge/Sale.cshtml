@using Local133.Web.Areas.Merchant.Controllers
@using Local133.Web.Areas.Merchant.Models
@using Local133.Web.Hubs
@model SaleQrViewModel
@{
    ViewData["Title"] = $"Venta {Model.Folio}";
    var notice = TempData[ChargeController.SaleNoticeKey] as string;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center"
         data-sale="@Model.Id"
         data-sale-status="@Model.Status"
         data-expired="@(Model.IsExpired ? "true" : "false")"
         data-status-url="@Url.Content($"~/api/sales/{Model.Id}")"
         data-hub-url="@Url.Content($"~{SalesHub.Path}")">
        @if (notice is not null)
        {
            <div class="alert alert-info text-start" role="status" data-sale-notice>@notice</div>
        }

        <div class="@(Model.IsPaid ? null : "d-none")" data-paid-only>
            <i class="bi bi-check-circle-fill text-success paid-icon" aria-hidden="true"></i>
            <h1 class="h3 fw-semibold text-success mt-2 mb-1" role="status" aria-live="assertive">Pago recibido</h1>
        </div>

        <p class="text-body-secondary mb-1">Venta @Model.Folio</p>
        <p class="display-5 fw-semibold @(Model.Concept is null ? "mb-3" : "mb-1")" data-sale-amount>@Model.AmountText</p>
        @if (Model.Concept is not null)
        {
            <p class="text-body-secondary text-break mb-3" data-sale-concept>@Model.Concept</p>
        }

        <div class="text-body-secondary mb-3 @(Model.IsPaid ? null : "d-none")" data-paid-only>
            <p class="mb-1">El dinero ya está en tu cuenta bancaria.</p>
            <p class="small mb-0">Pagado el <span data-paid-at>@Model.PaidAtText</span></p>
        </div>

        @if (Model.ShowQr)
        {
            <div data-pending-only>
                <div class="sale-qr mx-auto mb-3" data-sale-qr data-qr-string="@Model.QrString" role="img" aria-label="Código QR CoDi para pagar @Model.AmountText">
                    <noscript><p class="text-danger small mb-0">Activa JavaScript para mostrar el código QR.</p></noscript>
                </div>
                <p class="text-danger small d-none" data-qr-error role="alert">No pudimos dibujar el código QR. Genera un cobro nuevo.</p>
                <p class="mb-1">Pídele a tu cliente que lo escanee con la app de su banco.</p>
                @if (Model.RemainingSeconds is not null)
                {
                    <p class="text-body-secondary" aria-live="polite">
                        Expira en <span class="fw-semibold font-monospace" data-expires-in="@Model.RemainingSeconds">@Model.RemainingText</span>
                    </p>
                }
                <p class="small text-body-secondary d-flex align-items-center justify-content-center gap-2 mb-3" data-waiting>
                    <span class="spinner-grow spinner-grow-sm text-primary" aria-hidden="true"></span>
                    Esperando el pago…
                </p>
            </div>
        }

        <div class="alert alert-warning @(Model.IsExpired ? null : "d-none")" role="status" data-expired-only>
            <i class="bi bi-clock-history me-1" aria-hidden="true"></i> Este QR expiró sin pago. Genera un cobro nuevo.
        </div>

        @if (Model.IsCancelled)
        {
            <div class="alert alert-secondary text-start" role="status" data-cancelled-only>
                <i class="bi bi-x-circle me-1" aria-hidden="true"></i> Cancelaste este cobro. Si tu cliente ya había escaneado el
                QR, todavía podría pagarlo mientras no expire; si lo hace, aquí verás el pago.
            </div>
        }

        <a class="btn btn-primary btn-lg w-100" href="~/app/cobrar" data-new-charge><i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo cobro</a>

        @if (Model.CanCancel)
        {
            <div data-pending-only>
                <button type="button" class="btn btn-link link-danger mt-2" data-bs-toggle="modal" data-bs-target="#cancel-sale" data-cancel-sale>
                    Cancelar cobro
                </button>
            </div>
        }
    </div>
</div>

@if (Model.CanCancel)
{
    <div class="modal fade" id="cancel-sale" tabindex="-1" aria-labelledby="cancel-sale-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="cancel-sale-title">¿Cancelar este cobro?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">La venta @Model.Folio por @Model.AmountText quedará cancelada.</p>
                    <p class="small text-body-secondary mb-0">
                        CoDi no permite anular un QR: si tu cliente ya lo escaneó, todavía podría pagarlo hasta que expire.
                        Si paga, la venta se marcará como pagada.
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">No, seguir esperando</button>
                    <form method="post" action="@Url.Content($"~/app/cobrar/venta/{Model.Id}/cancelar")" data-disable-on-submit data-cancel-form>
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Sí, cancelar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.ShowQr)
    {
        <script src="~/lib/qrcodejs/qrcode.min.js"></script>
    }
    @if (Model.ListensForPayment)
    {
        <script src="~/lib/microsoft-signalr/dist/browser/signalr.min.js"></script>
        <script src="~/js/sale-qr.js"></script>
    }
}
