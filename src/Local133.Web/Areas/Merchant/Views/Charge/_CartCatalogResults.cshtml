@using Local133.Web.Areas.Merchant.Models
@using Local133.Web.Models
@model ProductListViewModel
@* Catálogo del carrito: conteo, productos (botones que cart.js agrega a la venta) y paginación. Lo usan la página
   (/app/cobrar/productos) y el fragmento de la búsqueda asíncrona (/app/cobrar/productos/catalogo). *@
@{
    var total = Model.Page.TotalCount;
    var pager = new PagerViewModel(Model.Page, p => Url.Content("~" + Model.UrlForPage(p)), "Páginas del catálogo");
}
<p class="small text-body-secondary mb-2" data-products-count>
    @if (Model.Query is null)
    {
        @(total == 1 ? "1 producto" : $"{total:N0} productos") @:· toca uno para agregarlo
    }
    else
    {
        @(total == 1 ? "1 resultado" : $"{total:N0} resultados") @:para «@Model.Query» ·
        <a href="@Url.Content("~" + Model.ListPath)" data-clear-search>Ver todos</a>
    }
</p>

@if (Model.Items.Count == 0)
{
    <div class="card" data-products-no-results>
        <div class="card-body text-center text-body-secondary">
            @if (Model.Query is null)
            {
                @:Ya no tienes productos.
            }
            else
            {
                @:No encontramos productos con «@Model.Query».
            }
        </div>
    </div>
}
else
{
    <div class="list-group mb-3" data-cart-catalog>
        @foreach (var item in Model.Items)
        {
            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 text-start"
                    data-cart-add data-product-id="@item.Id" data-name="@item.Name" data-price="@item.PriceValue"
                    data-price-text="@item.PriceText" data-thumb="@item.ThumbnailUrl" aria-label="Agregar @item.Name, @item.PriceText">
                <partial name="_ProductRowContent" model="item" />
                <span class="cart-add-icon d-flex align-items-center justify-content-center rounded-circle bg-primary text-white" aria-hidden="true">
                    <i class="bi bi-plus-lg"></i>
                </span>
            </button>
        }
    </div>

    <partial name="_Pager" model="pager" />
}
