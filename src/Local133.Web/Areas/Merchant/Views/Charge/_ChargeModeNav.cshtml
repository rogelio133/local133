@using Local133.Web.Areas.Merchant.Models
@model bool
@* Pestañas «Monto | Productos» (ligas entre páginas). Modelo: true = la página actual es la de productos.
   Van seguidas de un .charge-mode-panel con el contenido de la pestaña activa (estilos en site.scss). *@
<nav class="charge-mode-tabs" aria-label="Cómo armar el cobro" data-charge-mode-nav>
    <a class="charge-mode-tab @(Model ? null : "is-active")" href="@Url.Content("~" + ChargeUrls.Amount)" aria-current="@(Model ? null : "page")" data-charge-mode="amount">
        <i class="bi bi-123" aria-hidden="true"></i> Monto
    </a>
    <a class="charge-mode-tab @(Model ? "is-active" : null)" href="@Url.Content("~" + ChargeUrls.Cart)" aria-current="@(Model ? "page" : null)" data-charge-mode="cart">
        <i class="bi bi-basket" aria-hidden="true"></i> Productos
    </a>
</nav>
