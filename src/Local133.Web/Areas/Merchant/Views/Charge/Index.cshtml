@using Local133.Web.Areas.Merchant.Models
@using Local133.Domain.Sales
@using Local133.Application.Sales
@model ChargeFormViewModel
@{
    ViewData["Title"] = "Cobrar";
    var isPush = Model.Input.IsPushNotification;
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4 mb-3">Cobrar</h1>

        @if (Model.Blocked is { } blocked)
        {
            <div class="card" data-charge-blocked>
                <div class="card-body">
                    <h2 class="h5 card-title"><i class="bi bi-lock-fill text-body-secondary me-1" aria-hidden="true"></i> @blocked.Title</h2>
                    <p class="card-text text-body-secondary">@blocked.Message</p>
                    <a class="btn btn-primary btn-lg w-100" href="@Url.Content(blocked.LinkHref)">@blocked.LinkText</a>
                </div>
            </div>
        }
        else
        {
            <form asp-area="Merchant" asp-controller="Charge" asp-action="Create" method="post" data-charge-form data-disable-on-submit novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <fieldset class="mb-3">
                    <legend class="visually-hidden">Cómo cobrar</legend>
                    <div class="btn-group w-100" role="group" data-charge-method>
                        <input type="radio" class="btn-check" name="Input.Method" id="charge-method-qr" autocomplete="off"
                               value="@ChargeMethod.DynamicQr" checked="@(!isPush)" />
                        <label class="btn btn-outline-primary btn-lg" for="charge-method-qr">
                            <i class="bi bi-qr-code me-1" aria-hidden="true"></i> QR
                        </label>
                        <input type="radio" class="btn-check" name="Input.Method" id="charge-method-phone" autocomplete="off"
                               value="@ChargeMethod.PushNotification" checked="@isPush" />
                        <label class="btn btn-outline-primary btn-lg" for="charge-method-phone">
                            <i class="bi bi-phone me-1" aria-hidden="true"></i> Celular
                        </label>
                    </div>
                </fieldset>

                <div class="card mb-3">
                    <div class="card-body">
                        <label asp-for="Input.Amount" class="form-label text-body-secondary"></label>
                        <div class="input-group input-group-lg amount-input-group">
                            <span class="input-group-text" aria-hidden="true">$</span>
                            <input asp-for="Input.Amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                                   maxlength="9" class="form-control amount-input" aria-required="true" data-amount-input />
                            <span class="input-group-text" aria-hidden="true">MXN</span>
                        </div>
                        <span asp-validation-for="Input.Amount" class="d-block text-danger small mt-1"></span>
                        <div class="form-text">Sin signos y con hasta 2 decimales. El dinero llega completo a tu cuenta.</div>

                        <label asp-for="Input.Concept" class="form-label text-body-secondary mt-3"></label>
                        <input asp-for="Input.Concept" type="text" autocomplete="off" autocapitalize="sentences"
                               maxlength="@Sale.ConceptTextMaxLength" class="form-control form-control-lg" aria-required="true"
                               placeholder="Ej. 2 tacos al pastor" data-concept-input data-val-trim />
                        <span asp-validation-for="Input.Concept" class="d-block text-danger small mt-1"></span>
                        <div class="form-text">Tu cliente lo verá en su app junto con el nombre de tu negocio.</div>

                        <div class="@(isPush ? null : "d-none")" data-phone-field>
                            <label asp-for="Input.PhoneNumber" class="form-label text-body-secondary mt-3"></label>
                            <input asp-for="Input.PhoneNumber" type="tel" inputmode="numeric" autocomplete="tel-national"
                                   spellcheck="false" maxlength="@ChargeInput.PhoneNumberInputMaxLength"
                                   class="form-control form-control-lg" aria-required="true" placeholder="Ej. 55 1234 5678"
                                   data-val-required="@SalePhoneMessages.Required" data-phone-input disabled="@(!isPush)" />
                            <span asp-validation-for="Input.PhoneNumber" class="d-block text-danger small mt-1"></span>
                            <div class="form-text">10 dígitos. Tu cliente debe tener CoDi activo en la app de su banco con este número.</div>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100" data-charge-submit>
                    <i class="bi @(isPush ? "bi-send" : "bi-qr-code") me-1" aria-hidden="true" data-charge-submit-icon></i>
                    <span data-charge-submit-label>@(isPush ? "Enviar cobro" : "Generar QR")</span>
                </button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @if (Model.Blocked is null)
    {
        <partial name="_ValidationScriptsPartial" />
        <script src="~/js/amount-input.js"></script>
        <script src="~/js/charge-form.js"></script>
    }
}
