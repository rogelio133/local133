@using Local133.Web.Areas.Merchant.Models
@using Local133.Application.Sales
@model ChargeOptionsInput
@* Celular del cliente (solo con «Celular»; charge-form.js lo muestra y lo habilita). Se incluye con
   <partial name="_PhoneField" for="Input" /> para que el campo se llame Input.PhoneNumber. *@
<div class="@(Model.IsPushNotification ? null : "d-none")" data-phone-field>
    <label asp-for="PhoneNumber" class="form-label text-body-secondary mt-3"></label>
    <input asp-for="PhoneNumber" type="tel" inputmode="numeric" autocomplete="tel-national"
           spellcheck="false" maxlength="@ChargeOptionsInput.PhoneNumberInputMaxLength"
           class="form-control form-control-lg" aria-required="true" placeholder="Ej. 55 1234 5678"
           data-val-required="@SalePhoneMessages.Required" data-phone-input disabled="@(!Model.IsPushNotification)" />
    <span asp-validation-for="PhoneNumber" class="d-block text-danger small mt-1"></span>
    <div class="form-text">10 dígitos. Tu cliente debe tener CoDi activo en la app de su banco con este número.</div>
</div>
