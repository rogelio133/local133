@using Local133.Web.Areas.Merchant.Models
@using Local133.Domain.Sales
@model PaymentLinkPocFormViewModel
@{
    ViewData["Title"] = "Generar link de pago";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h4 mb-3">Generar link de pago</h1>

        <div class="alert alert-warning small" role="note" data-payment-link-poc-notice>
            <strong>Prueba de concepto.</strong> Pey no permite elegir la cuenta destino en los links de pago:
            el dinero cae en la cuenta de la plataforma. Solo para ver cómo se ve la página de pago.
        </div>

        @if (Model.HttpsWarning is { } warning)
        {
            <div class="alert alert-danger small" role="alert" data-payment-link-https-warning>@warning</div>
        }

        <form asp-area="Merchant" asp-controller="PaymentLinkPoc" asp-action="Create" method="post" data-disable-on-submit novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <label asp-for="Input.Amount" class="form-label text-body-secondary"></label>
            <div class="input-group input-group-lg">
                <span class="input-group-text" aria-hidden="true">$</span>
                <input asp-for="Input.Amount" type="text" inputmode="decimal" autocomplete="off" spellcheck="false"
                       maxlength="9" class="form-control" aria-required="true" data-amount-input />
                <span class="input-group-text" aria-hidden="true">MXN</span>
            </div>
            <span asp-validation-for="Input.Amount" class="d-block text-danger small mt-1"></span>

            <label asp-for="Input.Concept" class="form-label text-body-secondary mt-3"></label>
            <input asp-for="Input.Concept" type="text" autocomplete="off" autocapitalize="sentences"
                   maxlength="@Sale.ConceptTextMaxLength" class="form-control form-control-lg" aria-required="true"
                   placeholder="Ej. 2 tacos al pastor" data-val-trim />
            <span asp-validation-for="Input.Concept" class="d-block text-danger small mt-1"></span>
            <div class="form-text">Pey no tiene campo de concepto: va en la metadata y en la referencia del link.</div>

            <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">
                <i class="bi bi-link-45deg me-1" aria-hidden="true"></i> Generar link de pago
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/amount-input.js"></script>
}
