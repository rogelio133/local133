@using Local133.Web.Areas.Merchant.Controllers
@using Local133.Web.Areas.Merchant.Models
@model ProductListViewModel
@{
    ViewData["Title"] = "Productos";
    var notice = TempData[ProductsController.NoticeKey] as string;
    var warning = TempData[ProductsController.WarningKey] as string;
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8" data-products data-can-manage="@(Model.CanManage ? "true" : "false")">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h1 class="h4 mb-0">Productos</h1>
            @if (Model.CanManage && !Model.IsCatalogEmpty)
            {
                <a class="btn btn-primary" href="@Url.Content($"~{ProductUrls.New}")" data-new-product>
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Nuevo
                </a>
            }
        </div>

        @if (notice is not null)
        {
            <div class="alert alert-success" role="status" data-product-notice><i class="bi bi-check-circle-fill me-1" aria-hidden="true"></i> @notice</div>
        }
        @if (warning is not null)
        {
            <div class="alert alert-warning" role="alert" data-product-warning><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i> @warning</div>
        }
        @if (Model.ReadOnlyReason == CatalogReadOnlyReason.Disabled)
        {
            <div class="alert alert-secondary" role="status" data-products-readonly>
                Tu cuenta está dada de baja: puedes consultar tus productos, pero no modificarlos.
            </div>
        }
        else if (Model.ReadOnlyReason == CatalogReadOnlyReason.Plan)
        {
            <div class="mb-3" data-products-readonly data-products-readonly-plan>
                <partial name="_ProRequired" model='new ProRequiredViewModel(
                    "Tu catálogo es de solo lectura",
                    "Con el plan gratuito puedes consultar tus productos. Con Pro los agregas, los editas y cobras con ellos.",
                    Model.Query is null ? ProductListViewModel.WaitingCatalogText(Model.Page.TotalCount) : null,
                    "bi-box-seam")' />
            </div>
        }

        @if (Model.IsCatalogEmpty)
        {
            <div class="card text-center" data-products-empty>
                <div class="card-body py-5">
                    <i class="bi bi-box-seam display-4 text-body-secondary" aria-hidden="true"></i>
                    <h2 class="h5 mt-3">Aún no tienes productos</h2>
                    <p class="text-body-secondary">Agrégalos con su precio y una foto; después podrás cobrarlos desde tu catálogo.</p>
                    @if (Model.CanManage)
                    {
                        <a class="btn btn-primary btn-lg" href="@Url.Content($"~{ProductUrls.New}")" data-new-product>
                            <i class="bi bi-plus-lg me-1" aria-hidden="true"></i> Agregar mi primer producto
                        </a>
                    }
                </div>
            </div>
        }
        else
        {
            @* Sin JS es un GET normal; product-search.js busca al escribir y con Enter sin recargar la página. *@
            <form method="get" action="@Url.Content($"~{ProductUrls.List}")" role="search" class="mb-3" data-product-search
                  data-results-url="@Url.Content($"~{ProductUrls.Results}")">
                <div class="input-group">
                    <input type="search" name="q" value="@Model.Query" class="form-control" maxlength="@ProductListViewModel.QueryMaxLength"
                           placeholder="Buscar por nombre" aria-label="Buscar productos por nombre" autocomplete="off" enterkeyhint="search" />
                    <button type="submit" class="btn btn-outline-primary" aria-label="Buscar"><i class="bi bi-search" aria-hidden="true"></i></button>
                </div>
            </form>

            <div data-product-results aria-live="polite">
                <partial name="_ProductResults" model="Model" />
            </div>
        }
    </div>
</div>

@section Scripts {
    @if (!Model.IsCatalogEmpty)
    {
        <script src="~/js/product-search.js"></script>
    }
}
