@{
    ViewData["Title"] = "Inicio";
    // Checklist estático; en el paso 1.5 se alimenta del estatus real del Merchant.
    var onboarding = new (string Label, int Phase)[]
    {
        ("Crear tu cuenta", 1),
        ("Registrar tu cuenta bancaria (CLABE)", 2),
        ("Revisión de Banxico (hasta 5 días hábiles)", 2),
        ("¡Listo para cobrar con CoDi!", 2),
    };
}
<h1 class="h4 mb-3">Inicio</h1>

<div class="card">
    <div class="card-header">Activa tu cuenta</div>
    <ol class="list-group list-group-flush list-group-numbered">
        @foreach (var step in onboarding)
        {
            <li class="list-group-item d-flex justify-content-between align-items-start">
                <span class="ms-2 me-auto">@step.Label</span>
                <span class="badge text-bg-light border">Fase @step.Phase</span>
            </li>
        }
    </ol>
</div>
