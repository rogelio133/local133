@{
    ViewData["Title"] = "Más";
}
<div class="list-group mb-3">
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/mi-informacion" data-more-profile>
        <i class="bi bi-person-vcard fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Mi información</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/plan" data-more-plan>
        <i class="bi bi-stars fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Mi plan</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/productos" data-more-products>
        <i class="bi bi-box-seam fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Productos</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/tienda" data-more-storefront>
        <i class="bi bi-shop fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Catálogo en línea</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/cuenta-bancaria">
        <i class="bi bi-bank fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Cuenta bancaria</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="~/app/invita" data-more-invite>
        <i class="bi bi-gift fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">Invita y gana</span>
        <i class="bi bi-chevron-right text-body-secondary" aria-hidden="true"></i>
    </a>
    @* QR impreso del puesto (2.7): función de Pro anunciada, todavía no existe. *@
    <div class="list-group-item d-flex align-items-center gap-3 text-body-secondary" data-more-static-qr>
        <i class="bi bi-qr-code fs-5" aria-hidden="true"></i>
        <span class="flex-grow-1">QR de tu puesto</span>
        <partial name="_ComingSoonBadge" />
    </div>
</div>
