@using Local133.Web.Areas.Merchant.Models
@model SaleLockedViewModel
@{
    ViewData["Title"] = $"Venta {Model.Folio}";
}
@* Plan gratuito (5.5): la venta es más vieja que los días de historial. Sigue guardada; con Pro se vuelve a ver. *@
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8" data-sale-locked>
        <a class="d-inline-block mb-3" href="@Url.Content("~" + SalesUrls.List)" data-back-to-sales>
            <i class="bi bi-chevron-left" aria-hidden="true"></i> Ventas
        </a>

        <div class="card mb-3">
            <div class="card-body">
                <h1 class="h5 mb-1">Venta @Model.Folio</h1>
                <p class="small text-body-secondary mb-0">Creada el @Model.CreatedAtText</p>
            </div>
        </div>

        <partial name="_ProRequired" model='new ProRequiredViewModel(
            "Esta venta es de hace más de " + Model.HistoryDays + " días",
            "Con el plan gratuito ves las ventas de los últimos " + Model.HistoryDays + " días. Tus ventas anteriores siguen guardadas: con Pro las consultas todas.",
            null,
            "bi-clock-history")' />
    </div>
</div>
