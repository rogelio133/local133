@using Local133.Web.Areas.Merchant.Models
@model SalesHistoryViewModel
@{
    ViewData["Title"] = "Ventas";
    var summary = Model.Summary;
    var total = Model.Page.TotalCount;
    var pager = new PagerViewModel(Model.Page, p => Url.Content("~" + Model.UrlFor(page: p)), "Páginas de ventas");
    var today = SaleFormats.IsoDate(Model.Today);
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8" data-sales>
        <h1 class="h4 mb-3">Ventas</h1>

        @* Resumen del día (hora de México). *@
        <section class="row g-2 mb-3" aria-label="Resumen de hoy" data-day-summary>
            <div class="col-12 col-sm-4">
                <div class="card h-100">
                    <div class="card-body py-2">
                        <div class="small text-body-secondary">Cobrado hoy</div>
                        <div class="fs-4 fw-bold text-nowrap" data-day-collected>@summary.CollectedText</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-sm-4">
                @* El atajo filtra por el día de hoy: el filtro de fechas es de Pro, así que en el gratuito es solo el número. *@
                <a class="card h-100 text-decoration-none text-body" href="@(Model.IsHistoryLimited ? Url.Content("~" + Model.UrlFor(SaleStatusFilter.Paid)) : Url.Content("~" + SalesUrls.List + $"?{SaleStatusFilters.QueryKey}=pagadas&desde={today}&hasta={today}"))">
                    <div class="card-body py-2">
                        <div class="small text-body-secondary">Pagadas hoy</div>
                        <div class="fs-4 fw-bold" data-day-paid>@summary.PaidSalesCount.ToString("N0")</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-sm-4">
                <a class="card h-100 text-decoration-none text-body" href="@Url.Content("~" + SalesUrls.List + $"?{SaleStatusFilters.QueryKey}=pendientes")">
                    <div class="card-body py-2">
                        <div class="small text-body-secondary">Esperando pago</div>
                        <div class="fs-4 fw-bold" data-day-pending>@summary.PendingCount.ToString("N0")</div>
                    </div>
                </a>
            </div>
        </section>

        @if (!Model.HasAnySales)
        {
            <div class="card text-center" data-sales-empty>
                <div class="card-body py-5">
                    <i class="bi bi-receipt display-4 text-body-secondary" aria-hidden="true"></i>
                    <h2 class="h5 mt-3">Aún no tienes ventas</h2>
                    <p class="text-body-secondary">Cuando cobres con CoDi, aquí verás cada venta y si ya se pagó.</p>
                    <a class="btn btn-primary btn-lg" href="~/app/cobrar"><i class="bi bi-qr-code me-1" aria-hidden="true"></i> Cobrar</a>
                </div>
            </div>
        }
        else
        {
            @* Filtros: enlaces y un GET normal (sin JS). *@
            <nav class="d-flex flex-wrap gap-2 mb-2" aria-label="Filtrar por estatus" data-status-filters>
                @foreach (var filter in SaleStatusFilters.All)
                {
                    var active = filter == Model.Status;
                    <a class="btn btn-sm rounded-pill @(active ? "btn-primary" : "btn-outline-primary")" href="@Url.Content("~" + Model.UrlFor(filter))"
                       aria-current="@(active ? "true" : null)" data-status-filter="@(SaleStatusFilters.Slug(filter) ?? "todas")">@SaleStatusFilters.Label(filter)</a>
                }
            </nav>

            @if (Model.IsHistoryLimited)
            {
                <p class="small text-body-secondary mb-3" data-date-filter-pro>
                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i>Últimos @Model.HistoryDays días.
                    Filtra por fecha y consulta todo tu historial con <a href="@Url.Content("~" + PlanUrls.Plan)">Pro</a>.
                </p>
            }
            else
            {
            <details class="card mb-3" open="@Model.HasDateFilter" data-date-filter>
                <summary class="card-body py-2 small fw-semibold">
                    <i class="bi bi-calendar3 me-1" aria-hidden="true"></i> @(Model.DateFilterText ?? "Filtrar por fecha")
                </summary>
                <form method="get" action="@Url.Content("~" + SalesUrls.List)" class="card-body pt-0">
                    @if (SaleStatusFilters.Slug(Model.Status) is { } slug)
                    {
                        <input type="hidden" name="@SaleStatusFilters.QueryKey" value="@slug" />
                    }
                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label class="form-label small mb-1" for="desde">Desde</label>
                            <input class="form-control" type="date" id="desde" name="desde" max="@today" value="@(Model.From is { } f ? SaleFormats.IsoDate(f) : null)" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1" for="hasta">Hasta</label>
                            <input class="form-control" type="date" id="hasta" name="hasta" max="@today" value="@(Model.To is { } t ? SaleFormats.IsoDate(t) : null)" />
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Content("~" + Model.UrlForLastDays(1))" data-date-today>Hoy</a>
                        <a class="btn btn-outline-primary btn-sm" href="@Url.Content("~" + Model.UrlForLastDays(7))" data-date-week>Últimos 7 días</a>
                        @if (Model.HasDateFilter)
                        {
                            <a class="btn btn-link btn-sm" href="@Url.Content("~" + Model.UrlFor(keepDates: false))" data-clear-dates>Quitar fechas</a>
                        }
                    </div>
                </form>
            </details>
            }

            <p class="small text-body-secondary mb-2" data-sales-count>
                @(total == 1 ? "1 venta" : $"{total:N0} ventas")
                @if (Model.IsFiltered)
                {
                    @: · <a href="@Url.Content("~" + SalesUrls.List)" data-clear-filters>Ver todas</a>
                }
            </p>

            @if (Model.Days.Count == 0)
            {
                <div class="card" data-sales-no-results>
                    <div class="card-body text-center text-body-secondary">
                        @(Model.IsHistoryLimited && !Model.IsFiltered ? $"No tienes ventas en los últimos {Model.HistoryDays} días." : "No hay ventas con estos filtros.")
                    </div>
                </div>
            }
            else
            {
                @foreach (var day in Model.Days)
                {
                    <h2 class="h6 text-body-secondary mt-3 mb-2" data-sales-day>@day.Label</h2>
                    <div class="list-group mb-2">
                        @foreach (var row in day.Rows)
                        {
                            <a class="list-group-item list-group-item-action d-flex align-items-center gap-3" href="@Url.Content("~" + SalesUrls.Detail(row.Id))" data-sale-row="@row.Id" data-status="@row.Status">
                                <i class="bi @SaleStatusText.MethodIcon(row.Method, row.Source) fs-5 text-body-secondary" aria-hidden="true"></i>
                                <span class="sale-row-info flex-grow-1">
                                    <span class="d-block small text-body-secondary">Venta @row.Folio · @row.TimeText</span>
                                    <span class="d-block text-truncate">@(row.ConceptText ?? "Sin concepto")</span>
                                </span>
                                <span class="text-end">
                                    <span class="d-block fw-semibold text-nowrap">@row.AmountText</span>
                                    <span class="badge @SaleStatusText.BadgeClass(row.Status)">@SaleStatusText.Label(row.Status)</span>
                                </span>
                            </a>
                        }
                    </div>
                }

                <div class="mt-3">
                    <partial name="_Pager" model="pager" />
                </div>
            }

            @if (Model.HiddenOlderText is { } hiddenOlder)
            {
                <div class="mt-3" data-sales-hidden-older="@Model.HiddenOlderCount">
                    <partial name="_ProRequired" model='new ProRequiredViewModel(
                        hiddenOlder,
                        $"Con el plan gratuito ves las ventas de los últimos {Model.HistoryDays} días. Las anteriores siguen guardadas: con Pro consultas todo tu historial.",
                        null,
                        "bi-clock-history")' />
                </div>
            }
        }
    </div>
</div>
