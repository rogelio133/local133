@using Local133.Web.Areas.Merchant.Models
@model GraceBannerViewModel
@* Mismo ancho que el contenido de la mayoría de las pantallas (Ventas, Productos, Mi plan). *@
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8">
        <div class="alert alert-warning d-flex flex-column flex-sm-row align-items-sm-center gap-2 mb-3" role="alert" data-grace-banner>
            <i class="bi bi-hourglass-split fs-4 d-none d-sm-inline" aria-hidden="true"></i>
            <span class="flex-grow-1">
                <span class="d-block fw-bold">Tu plan @Model.PlanLabel venció el @Model.LastActiveDayText</span>
                <span class="d-block small">@Model.DeadlineText</span>
            </span>
            <a class="btn btn-primary text-nowrap" href="@Url.Content("~" + PlanUrls.Plan)" data-grace-pay>Renovar ahora</a>
        </div>
    </div>
</div>
