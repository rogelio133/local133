@{
    // Portal del vendedor: móvil primero (pestañas inferiores); en ≥md las pestañas pasan a la barra superior.
    var current = ViewContext.RouteData.Values["action"] as string;
    var tabs = new (string Action, string Href, string Label, string Icon)[]
    {
        ("Index", "~/app", "Inicio", "bi-house"),
        ("Charge", "~/app/cobrar", "Cobrar", "bi-qr-code"),
        ("Sales", "~/app/ventas", "Ventas", "bi-receipt"),
        ("More", "~/app/mas", "Más", "bi-three-dots"),
    };
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
</head>
<body>
    <nav class="navbar bg-primary sticky-top" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" href="~/app">Local133</a>
            <div class="navbar-nav flex-row gap-3 d-none d-md-flex">
                @foreach (var tab in tabs)
                {
                    var active = tab.Action == current;
                    <a class="nav-link @(active ? "active" : null)" href="@Url.Content(tab.Href)" aria-current="@(active ? "page" : null)">@tab.Label</a>
                }
            </div>
            <partial name="_LoginPartial" />
        </div>
    </nav>

    <main class="container app-main pt-3">
        @RenderBody()
    </main>

    <nav class="tabbar nav nav-justified fixed-bottom bg-body border-top d-md-none" aria-label="Navegación principal">
        @foreach (var tab in tabs)
        {
            var active = tab.Action == current;
            <a class="nav-link @(active ? "active" : null)" href="@Url.Content(tab.Href)" aria-current="@(active ? "page" : null)">
                <i class="bi @tab.Icon tab-icon" aria-hidden="true"></i>
                @tab.Label
            </a>
        }
    </nav>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
