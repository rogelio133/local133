@{
    // PWA (punto 12): manifest, metas de iOS y pwa.js (_Head y _Scripts).
    ViewData["Pwa"] = true;
    // Portal administrador: menú en Offcanvas en móvil; en ≥lg el mismo Offcanvas se muestra como sidebar fijo de 15rem,
    // que se puede ocultar a un riel de íconos (ajustes 2026-11-26, punto 13; admin-menu.js, estado en localStorage).
    // Cada liga es una rejilla ícono | etiqueta: si la etiqueta se parte, el ícono no se mueve.
    // Activo por controlador (Clientes queda activo en todo CustomersController) y, si se indica, por acción.
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;
    var links = new (string Controller, string? Action, string Href, string Label, string Icon)[]
    {
        ("Customers", null, "~/admin/clientes", "Clientes", "bi-people"),
        ("Home", "Dashboard", "~/admin/tablero", "Tablero", "bi-speedometer2"),
        ("Transactions", null, "~/admin/transacciones", "Transacciones", "bi-arrow-left-right"),
        ("Webhooks", null, "~/admin/webhooks", "Webhooks", "bi-broadcast"),
        ("Settings", null, "~/admin/parametros", "Parámetros", "bi-sliders"),
        // Contraseña y cuentas ligadas (Identity, con el layout público): nunca queda activa aquí.
        ("", null, "~/Identity/Account/Manage/ChangePassword", "Mi cuenta", "bi-person-gear"),
    };
}
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
    @* Antes de pintar: si el menú quedó oculto, la clase ya está y no hay parpadeo (admin-menu.js la mantiene). *@
    <script>try { if (localStorage.getItem('l133-admin-menu') === 'collapsed') document.documentElement.classList.add('admin-menu-collapsed'); } catch (e) { }</script>
</head>
<body>
    <nav class="navbar bg-dark sticky-top" data-bs-theme="dark">
        <div class="container-fluid justify-content-start">
            <button class="navbar-toggler d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#admin-menu" aria-controls="admin-menu" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <partial name="_NavbarBrand" model="NavbarBrandViewModel.Admin" />
            <div class="ms-auto">
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <div class="d-lg-flex">
        <div class="offcanvas-lg offcanvas-start admin-sidebar bg-body border-end" tabindex="-1" id="admin-menu" aria-labelledby="admin-menu-title">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title" id="admin-menu-title">Menú</h5>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#admin-menu" aria-label="Cerrar"></button>
            </div>
            <div class="offcanvas-body p-2">
                <nav class="nav nav-pills flex-column w-100">
                    @foreach (var link in links)
                    {
                        var active = link.Controller == currentController && (link.Action is null || link.Action == currentAction);
                        <a class="nav-link admin-nav-link @(active ? "active" : null)" href="@Url.Content(link.Href)" aria-current="@(active ? "page" : null)" title="@link.Label" data-admin-nav-link>
                            <i class="bi @link.Icon admin-nav-icon" aria-hidden="true"></i><span class="admin-nav-label">@link.Label</span>
                        </a>
                    }
                </nav>
            </div>
        </div>

        @* Pestaña de ocultar o mostrar (solo ≥lg): columna de ancho 0 pegada al borde derecho del menú; el botón va
           sticky a media altura de lo visible del menú, montado sobre el borde. *@
        <div class="admin-menu-handle d-none d-lg-block">
            <button class="admin-menu-toggle" type="button" data-admin-menu-toggle aria-controls="admin-menu" aria-expanded="true" aria-label="Ocultar menú" title="Ocultar menú">
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
            </button>
        </div>

        <main class="admin-main flex-grow-1 p-3 p-lg-4">
            @RenderBody()
        </main>
    </div>

    <partial name="_Scripts" />
    <script src="~/js/admin-menu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
