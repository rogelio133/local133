@model CustomerListViewModel
@* Conteo, lista y paginación de clientes. Lo usan la página completa y GET /admin/clientes/resultados. *@
@{
    var total = Model.Page.TotalCount;
    var pager = new PagerViewModel(Model.Page, p => Url.Content("~" + Model.UrlFor(p)), "Páginas de clientes");
}
@if (!Model.HasAnyMerchants)
{
    <div class="card text-center" data-customers-empty>
        <div class="card-body py-5 text-body-secondary">
            <i class="bi bi-people display-4" aria-hidden="true"></i>
            <p class="mt-3 mb-0">Aún no se registra ningún vendedor.</p>
        </div>
    </div>
}
else
{
    <p class="small text-body-secondary mb-2" data-customers-count="@total">
        @(total == 1 ? "1 cliente" : $"{total:N0} clientes")
        @if (Model.Filters.IsFiltered)
        {
            @: · <a href="@Url.Content("~" + CustomerUrls.List)" data-clear-search>Ver todos</a>
        }
    </p>

    @if (Model.Rows.Count == 0)
    {
        <div class="card" data-customers-no-results>
            <div class="card-body text-center text-body-secondary">No hay clientes con estos filtros.</div>
        </div>
    }
    else
    {
        <div class="list-group mb-3">
            @foreach (var row in Model.Rows)
            {
                <a class="list-group-item list-group-item-action" href="@Url.Content("~" + CustomerUrls.Detail(row.Id))"
                   data-customer-row="@row.Id" data-status="@row.Status" data-plan-tier="@row.Plan.Tier">
                    <div class="d-flex flex-wrap justify-content-between gap-2">
                        <div>
                            <div class="fw-semibold text-break">@row.Name <span class="small text-body-secondary fw-normal">#@row.Id</span></div>
                            @if (row.BusinessName is { } business)
                            {
                                <div class="small text-break">@business</div>
                            }
                            <div class="small text-body-secondary text-break">@row.Email</div>
                        </div>
                        <div class="text-md-end">
                            <span class="badge @AdminLabels.StatusBadge(row.Status)">@AdminLabels.Status(row.Status)</span>
                            <span class="badge @AdminLabels.PlanBadge(row.Plan.Tier)">@AdminLabels.Plan(row.Plan.Tier)</span>
                            @if (row.PlanDateText is { } planDate)
                            {
                                <div class="small text-body-secondary mt-1">@planDate</div>
                            }
                        </div>
                    </div>
                    <div class="small text-body-secondary mt-1">
                        Registro: @row.CreatedAtText
                        @if (row.CodiStatus is { } codi)
                        {
                            @: · Cuenta CoDi: @AdminLabels.Codi(codi)
                        }
                    </div>
                </a>
            }
        </div>

        <partial name="_Pager" model="pager" />
    }
}
