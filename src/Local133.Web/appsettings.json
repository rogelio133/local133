{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/local133-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Pey": {
    "BaseUrl": "https://api.pey.mx"
  },
  "Email": {
    "From": "Local133 <hola@notificaciones.local133.com.mx>"
  },
  "Jobs": {
    "Enabled": true
  },
  "Home": {
    "RotatingWords": [ "local", "puesto", "tienda", "kiosko", "negocio", "consultorio" ]
  },
  "AllowedHosts": "*"
}
