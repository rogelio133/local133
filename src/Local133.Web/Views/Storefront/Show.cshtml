@model StorefrontViewModel
@{
    ViewData["Title"] = Model.BusinessName;
    if (Model.IsPreview)
    {
        // La vista previa nunca se indexa (la ve solo el vendedor).
        ViewData["NoIndex"] = true;
    }

    var total = Model.Page.TotalCount;
    var pager = new PagerViewModel(Model.Page, p => Url.Content("~" + Model.UrlFor(p)), "Páginas del catálogo");
}
<div class="row justify-content-center">
    <div class="col-md-10 col-lg-8" data-storefront>
        @if (Model.IsPreview)
        {
            <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2" role="status" data-storefront-preview>
                <span><strong>Vista previa.</strong> Así ven tu catálogo tus clientes.</span>
                <a class="btn btn-sm btn-outline-primary" href="~/app/tienda">Volver</a>
            </div>
        }

        <div class="card mb-3 overflow-hidden">
            @if (Model.CoverUrl is not null)
            {
                <img class="storefront-cover" src="@Model.CoverUrl" alt="Foto de @Model.BusinessName" data-storefront-cover />
            }
            <div class="card-body d-flex align-items-center gap-3">
                @if (Model.LogoUrl is not null)
                {
                    <img class="storefront-logo rounded border" src="@Model.LogoUrl" alt="Logo de @Model.BusinessName" data-storefront-logo />
                }
                <div class="flex-grow-1 storefront-product-info">
                    <h1 class="h4 mb-1 text-break" data-storefront-name>@Model.BusinessName</h1>
                    @if (Model.AddressLines.Count > 0)
                    {
                        <p class="small text-body-secondary mb-0 text-break" data-storefront-address>
                            <i class="bi bi-geo-alt me-1" aria-hidden="true"></i>
                            @for (var i = 0; i < Model.AddressLines.Count; i++)
                            {
                                @if (i > 0)
                                {
                                    <br />
                                }
                                @Model.AddressLines[i]
                            }
                        </p>
                    }
                </div>
            </div>
            @if (Model.WhatsAppUrl is not null)
            {
                <div class="card-body border-top d-grid">
                    <a class="btn btn-success" href="@Model.WhatsAppUrl" target="_blank" rel="noopener noreferrer" data-storefront-whatsapp>
                        <i class="bi bi-whatsapp me-1" aria-hidden="true"></i> Pedir por WhatsApp
                    </a>
                </div>
            }
        </div>

        <form class="mb-3" method="get" action="@Url.Content("~" + Model.ListPath)" role="search" data-storefront-search>
            <label class="visually-hidden" for="storefront-q">Buscar productos</label>
            <div class="input-group">
                <input class="form-control" type="search" id="storefront-q" name="q" value="@Model.Query"
                       maxlength="@StorefrontViewModel.QueryMaxLength" placeholder="Buscar productos" autocomplete="off" />
                <button class="btn btn-outline-primary" type="submit" aria-label="Buscar">
                    <i class="bi bi-search" aria-hidden="true"></i>
                </button>
            </div>
        </form>

        <p class="small text-body-secondary mb-2" data-storefront-count>
            @if (Model.Query is null)
            {
                @(total == 1 ? "1 producto" : $"{total:N0} productos")
            }
            else
            {
                @(total == 1 ? "1 resultado" : $"{total:N0} resultados") @:para «@Model.Query» ·
                <a href="@Url.Content("~" + Model.ListPath)" data-storefront-clear>Ver todos</a>
            }
        </p>

        @if (Model.Products.Count == 0)
        {
            <div class="card mb-3" data-storefront-empty>
                <div class="card-body text-center text-body-secondary">
                    @if (Model.Query is null)
                    {
                        @:Este negocio todavía no tiene productos en su catálogo.
                    }
                    else
                    {
                        @:No encontramos productos con «@Model.Query».
                    }
                </div>
            </div>
        }
        else
        {
            <ul class="list-group mb-3" data-storefront-products>
                @foreach (var product in Model.Products)
                {
                    <li class="list-group-item d-flex align-items-start gap-3" data-storefront-product>
                        @if (product.ThumbnailUrl is not null)
                        {
                            <img class="storefront-product-img rounded" src="@product.ThumbnailUrl" alt="" width="72" height="72" loading="lazy" />
                        }
                        else
                        {
                            <span class="storefront-product-placeholder rounded bg-body-secondary d-flex align-items-center justify-content-center" aria-hidden="true">
                                <i class="bi bi-image text-body-secondary fs-4"></i>
                            </span>
                        }
                        <div class="flex-grow-1 storefront-product-info">
                            <div class="d-flex justify-content-between gap-2">
                                <span class="fw-semibold text-break">@product.Name</span>
                                <span class="fw-semibold text-nowrap" data-storefront-price>@product.PriceText</span>
                            </div>
                            @if (product.Description is not null)
                            {
                                <p class="small text-body-secondary mb-0 text-break">@product.Description</p>
                            }
                        </div>
                    </li>
                }
            </ul>

            <partial name="_Pager" model="pager" />
        }

        <p class="small text-body-secondary text-center mt-4 mb-0">
            Los precios los fija el negocio. Pide y paga directo con ellos.
        </p>
        <p class="small text-center mb-0" data-storefront-made-with>
            <a class="link-body-emphasis text-decoration-none" href="@Model.MadeWithUrl" target="_blank" rel="noopener">
                Catálogo hecho con <strong>Local133</strong>
            </a>
        </p>
    </div>
</div>
