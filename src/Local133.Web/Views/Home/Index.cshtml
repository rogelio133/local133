@using Local133.Application.Auth
@{
    ViewData["Title"] = "Cobra con CoDi";
}
<div class="py-4 text-center">
    <h1 class="display-6 fw-semibold">Cobra con CoDi desde tu puesto</h1>
    <p class="lead text-secondary">Genera un QR, tu cliente paga desde su app bancaria y el dinero llega directo a tu cuenta.</p>
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
        @if (User.IsInRole(Roles.Merchant))
        {
            <a class="btn btn-primary btn-lg" href="~/app">Ir a mi puesto</a>
        }
        else if (User.IsInRole(Roles.Admin))
        {
            <a class="btn btn-primary btn-lg" href="~/admin">Ir a administración</a>
        }
        else
        {
            <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Crear cuenta</a>
            <a class="btn btn-outline-secondary btn-lg" asp-area="Identity" asp-page="/Account/Login">Entrar</a>
        }
    </div>
</div>
