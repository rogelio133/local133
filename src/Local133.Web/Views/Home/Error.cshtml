@{
    ViewData["Title"] = "Error";
}
<div class="card text-center">
    <div class="card-body">
        <h1 class="h4">Algo salió mal</h1>
        <p class="text-secondary">No pudimos completar tu solicitud. Intenta de nuevo en un momento.</p>
        <p class="small text-secondary mb-3">Referencia: <code>@Context.TraceIdentifier</code></p>
        <a href="~/">Ir al inicio</a>
    </div>
</div>
