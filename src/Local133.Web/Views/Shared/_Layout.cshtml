@using Local133.Web.Hosting
@using Microsoft.Extensions.Options
@inject IOptions<PublicSiteOptions> Site
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
</head>
@* Footer siempre al fondo: body en columna con el alto de la ventana (.site-layout) y main que crece.
   ViewData["HideNavbar"] = true quita la barra (home sin sesión) y ViewData["BodyClass"] agrega una clase al body. *@
<body class="d-flex flex-column site-layout @(ViewData["BodyClass"] as string)">
    @if (ViewData["HideNavbar"] is not true)
    {
        <nav class="navbar navbar-expand bg-primary sticky-top d-print-none" data-bs-theme="dark">
            <div class="container">
                <partial name="_NavbarBrand" model="NavbarBrandViewModel.ForPublic(User)" />
                <div class="ms-auto">
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    }

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    @* Los textos legales viven en la portada (App:LandingUrl). *@
    <footer class="container pb-4 small text-center text-body-secondary d-print-none">
        <a class="text-body-secondary" href="@Site.Value.TermsUrl">Términos y condiciones</a>
        · <a class="text-body-secondary" href="@Site.Value.PrivacyNoticeUrl">Aviso de privacidad</a>
    </footer>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
