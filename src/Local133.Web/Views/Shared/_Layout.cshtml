@using Local133.Application.Auth
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
</head>
@* Footer siempre al fondo: body en columna con el alto de la ventana (.site-layout) y main que crece. *@
<body class="d-flex flex-column site-layout">
    <nav class="navbar navbar-expand bg-primary sticky-top d-print-none" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="~/">
                <img class="navbar-logo" src="~/img/local133-invertido.svg" alt="Local133" width="42" height="32" asp-append-version="true" />
            </a>
            <div class="navbar-nav ms-auto me-2">
                @if (User.IsInRole(Roles.Merchant))
                {
                    <a class="nav-link" href="~/app">Mi puesto</a>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <a class="nav-link" href="~/admin">Admin</a>
                }
            </div>
            <partial name="_LoginPartial" />
        </div>
    </nav>

    <main class="container py-4 flex-grow-1">
        @RenderBody()
    </main>

    <footer class="container pb-4 small text-center text-body-secondary d-print-none">
        <a class="text-body-secondary" href="~/terminos">Términos y condiciones</a>
        · <a class="text-body-secondary" href="~/aviso-de-privacidad">Aviso de privacidad</a>
    </footer>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
