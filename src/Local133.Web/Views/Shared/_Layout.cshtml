@using Local133.Application.Auth
<!DOCTYPE html>
<html lang="es-MX">
<head>
    <partial name="_Head" />
</head>
<body>
    <nav class="navbar navbar-expand bg-primary sticky-top" data-bs-theme="dark">
        <div class="container">
            <a class="navbar-brand" href="~/">Local133</a>
            <div class="navbar-nav ms-auto me-2">
                @if (User.IsInRole(Roles.Merchant))
                {
                    <a class="nav-link" href="~/app">Mi puesto</a>
                }
                @if (User.IsInRole(Roles.Admin))
                {
                    <a class="nav-link" href="~/admin">Admin</a>
                }
            </div>
            <partial name="_LoginPartial" />
        </div>
    </nav>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="container pb-4 small text-center text-secondary">
        <a class="link-secondary" href="~/terminos">Términos y condiciones</a>
        · <a class="link-secondary" href="~/aviso-de-privacidad">Aviso de privacidad</a>
    </footer>

    <partial name="_Scripts" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
