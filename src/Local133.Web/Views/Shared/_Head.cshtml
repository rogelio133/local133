@* <head> común a los tres layouts (público, vendedor, admin). *@
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="theme-color" content="#E4007C" />
@if (ViewData["NoIndex"] is true)
{
    <meta name="robots" content="noindex, nofollow" />
}
<title>@(ViewData["Title"] is string title ? $"{title} · Local133" : "Local133")</title>
@* Ícono de la marca: favicon.ico (varios tamaños, respaldo), local133.svg (vectorial, navegadores modernos)
   y apple-touch-icon.png para la pantalla de inicio de iOS. *@
<link rel="icon" href="~/favicon.ico" sizes="any" />
<link rel="icon" href="~/local133.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
@* Bootstrap compilado desde Styles/site.scss (variables en Styles/_custom.scss). *@
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
