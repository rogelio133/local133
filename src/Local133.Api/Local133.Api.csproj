<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>c52d76ff-da9b-49db-9a65-a8b34dd64078</UserSecretsId>
    <!-- La SPA no se compila con `dotnet build`; solo `dotnet publish` ejecuta npm (omitir con -p:SkipSpaBuild=true). -->
    <SpaRoot>$(MSBuildProjectDirectory)\..\Local133.CustomerPortal\</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Local133.Application\Local133.Application.csproj" />
    <ProjectReference Include="..\Local133.Infrastructure\Local133.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <!--
    En `dotnet publish` (_IsPublishing=true) compila la SPA ANTES del build para que los static web assets
    (incluida la compresión .br/.gz) se calculen con el wwwroot recién generado. Vite usa nombres con hash y
    vacía wwwroot, por eso se re-registra el Content de wwwroot tras compilar.
  -->
  <Target Name="BuildSpaForPublish" BeforeTargets="BeforeBuild"
          Condition="'$(_IsPublishing)' == 'true' And '$(SkipSpaBuild)' != 'true'">
    <Exec Command="node --version" ContinueOnError="true" StandardOutputImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
    </Exec>
    <Error Condition="'$(NodeExitCode)' != '0'" Text="Se requiere Node.js para publicar la SPA (o usa -p:SkipSpaBuild=true)." />

    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />

    <ItemGroup>
      <!-- No `Remove="wwwroot\**"`: el comodín se expande contra el disco y no quitaría archivos que Vite ya borró. -->
      <Content Remove="@(Content)" Condition="$([System.String]::Copy('%(Content.Identity)').Replace('/', '\').StartsWith('wwwroot\'))" />
      <Content Include="wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
