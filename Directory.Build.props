<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Smart App Control bloquea el apphost (.exe sin firma); sin él todo corre vía dotnet.exe (firmado). -->
    <UseAppHost>false</UseAppHost>
    <Company>Local133</Company>
    <Product>Local133 — Portal de cobros CoDi</Product>
    <Copyright>© Local133</Copyright>
    <Version>0.1.0</Version>
    <NeutralLanguage>es-MX</NeutralLanguage>
  </PropertyGroup>
</Project>
